# Upstream harness package clone — reference only (VS-001)
harness-standards/

# Backend
backend/target/
backend/.idea/
# Store uploads (ADR-108) — the default `coc.store.root` when run from backend/
# or the repo root. Installers, not source.
backend/store-files/
/store-files/
# Personal local overrides (real DB/OAuth values) — see application.yml's header.
backend/src/main/resources/application-local.yml

# Frontend
frontend/node_modules/
frontend/.next/
frontend/out/

# Local env — never commit credentials (L1 gitleaks also blocks these)
.env
.env.local
*.local.yml
# Actual naming in use is `application-local.yml` (hyphen, not a `.local.yml`
# suffix) — *.local.yml above does not match it. This has already let real
# credentials sit untracked-but-unignored twice; see application.yml's header.
*-local.yml

# Personal Claude Code overrides — shared config lives in .claude/settings.json
.claude/settings.local.json

# L2 audit reports are build output, not source.
/security/

# Same intent as the .env rules above, without the leading dot.
# backend/env.local arrived staged and matched neither pattern.
env.local
env.*.local
**/env.local

# ...and any near-miss of those names. On 2026-09-16 a mistyped `..env.local`
# matched none of the patterns above, and a commit then pointed application.yml
# at it — a file holding the database password, the Google client secret and
# the Firebase service account, one `git add .` from being tracked. The name
# people get wrong is exactly the one that stops being ignored.
*env.local

# Backend log output (logback-spring.xml).
/logs/
backend/logs/

# npm pack output (tools/claude-team-usage) — build artifacts, never source.
*.tgz

# A stray `yarn` at the repo root once committed these; the project uses npm
# (frontend/package-lock.json) and installs under frontend/.
/node_modules/
/yarn.lock
