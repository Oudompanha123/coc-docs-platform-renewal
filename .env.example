# Template for .env.local (which is gitignored and never committed).
# Copy this file to .env.local and fill in real values for your machine:
#   cp .env.example .env.local
#
# The backend reads these as plain OS environment variables — Spring Boot
# resolves ${DB_HOST} etc. in application.yml/application-dev.yml against
# them. They are NOT auto-loaded from this file; export them into your shell
# first, e.g.:
#   export $(grep -v '^#' .env.local | xargs) && mvn -f backend/pom.xml spring-boot:run

DB_HOST=<your-host-db>
DB_PORT=5432
DB_NAME=cocdocs
DB_USER=postgres
DB_PASSWORD=<you-db-password>
