#!/usr/bin/env bash
# Coc Docs Platform — block direct pushes to protected branches.
#
# GitHub rulesets are not enforced on private repos owned by a personal Free
# account, so this is the interim control. It runs on YOUR machine, before the
# push leaves it.
#
# Honest about what this is: it stops accidents, not determined circumvention.
# `--no-verify` bypasses it, and it only works on machines where it is
# installed. It is discipline, not security. Real enforcement needs a GitHub
# Team org (see CONTRIBUTING.md).
#
# Installed via: scripts/install-hooks.sh

set -uo pipefail

PROTECTED="main dev"
BYPASS_ENV="ALLOW_DIRECT_PUSH"

red()  { printf '\033[31m%s\033[0m\n' "$1"; }
bold() { printf '\033[1m%s\033[0m\n'  "$1"; }

blocked=0

# stdin: <local ref> <local sha> <remote ref> <remote sha>
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  [ -z "${remote_ref:-}" ] && continue
  branch="${remote_ref#refs/heads/}"

  for p in $PROTECTED; do
    if [ "$branch" = "$p" ]; then
      if [ "${!BYPASS_ENV:-}" = "1" ]; then
        red "[pre-push] BYPASS: pushing directly to '$branch' with ${BYPASS_ENV}=1"
        echo "[pre-push] This is logged in your shell history. Use it only when you have a reason you could defend."
        continue
      fi
      blocked=1
      echo ""
      red "  ✖  Direct push to '$branch' is not allowed."
      echo ""
      echo "  Everything reaches main and dev through a pull request — that is how"
      echo "  six people's work stays coherent. See CONTRIBUTING.md."
      echo ""
      bold "  What to do instead:"
      echo ""
      echo "    git checkout -b feature/short-description"
      echo "    git push -u origin feature/short-description"
      echo ""
      echo "  Then open a PR into dev. CI and the security scan run on it, and"
      echo "  someone else reviews it."
      echo ""
      echo "  Already committed on $branch by mistake? Move the work across:"
      echo ""
      echo "    git branch feature/short-description"
      echo "    git reset --hard origin/$branch"
      echo "    git checkout feature/short-description"
      echo ""
      echo "  If you genuinely must push directly:  ${BYPASS_ENV}=1 git push"
      echo ""
    fi
  done
done

exit $blocked
