# Line endings.
#
# core.autocrlf=true on this machine converts LF to CRLF on checkout, which is
# right for Windows editors and fatally wrong for anything a Linux container
# executes. A shell script with CRLF endings fails as:
#
#   /docker-entrypoint.d/05-ensure-certificate.sh: bad interpreter:
#   /bin/sh^M: no such file or directory
#
# — which names the file but not the cause, and looks like a missing shell.
#
# Everything below is either run inside a container or read by one, so it is
# pinned to LF regardless of the platform it is checked out on.

* text=auto

# Executed in containers
*.sh            text eol=lf
*Dockerfile     text eol=lf
*.dockerfile    text eol=lf
.dockerignore   text eol=lf

# Read by containers
docker-compose*.yml     text eol=lf
*.conf                  text eol=lf
*.conf.template         text eol=lf
infra/**                text eol=lf

# Read by the JVM and psql, where a stray CR is at best noise in a log
*.sql           text eol=lf
mvnw            text eol=lf

# Binary — never touched
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.jar binary
