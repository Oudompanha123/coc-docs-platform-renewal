# Coc Docs Platform — deployment configuration.
#
#   cp .env.example .env && nano .env && chmod 600 .env
#
# This is the only file you edit. Details and troubleshooting: README.md.


# === REQUIRED ==============================================================
# Nothing starts without these.

# DNS A record must already point at this instance (README: Before you start).
PUBLIC_DOMAIN=docs.example.com
ACME_EMAIL=ops@example.com

# NEXT_PUBLIC_SITE_URL is not listed here: compose derives it from
# PUBLIC_DOMAIN above. It is what makes a shared link show the preview image
# (app/opengraph-image.png), and it is compiled into the bundle, so a domain
# change needs docker compose build frontend, not a restart.

DB_NAME=cocdocs
DB_USER=cocdocs
DB_PASSWORD=

KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=

# Google Cloud Console -> APIs & Services -> Credentials.
# Add this to the client's Authorised redirect URIs, or sign-in fails:
#   https://<PUBLIC_DOMAIN>/auth/realms/docs_platform/broker/google/endpoint
GOOGLE_CLIENT_ID=
# SECRET — substituted into the Keycloak realm at import.
GOOGLE_CLIENT_SECRET=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


# === OPTIONAL ==============================================================
# Each one absent degrades to a documented state, never a crash.

# --- Email (ADR-017) -------------------------------------------------------
# Blank: reset links are logged instead of sent, and OTP registration cannot
# deliver. Google sign-in is unaffected.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- HRMS attendance, shared inbox (ADR-042, ADR-057) ----------------------
# Blank or APP_HRMS_ENABLED=false: nothing is polled, the Attendance page is
# empty and no "Attendance on ..." lines appear in the bell. Nothing crashes.
#
# This reads an IMAP mailbox that RECEIVES the HRMS report. It is unrelated to
# MAIL_* above, which SENDS. Both can be the same Google account; they are
# separate settings and separate protocols (993 IMAPS in, 587 SMTP out).
APP_HRMS_ENABLED=false
APP_HRMS_HOST=imap.gmail.com
APP_HRMS_PORT=993
# The mailbox to log into. SECRET below: a Google App Password, not the
# account password -- 16 characters, spaces optional.
APP_HRMS_USERNAME=
APP_HRMS_PASSWORD=
# Only mail from this address is read. Narrow it as far as HRMS allows: it is
# the only thing standing between this poller and the rest of the mailbox.
APP_HRMS_SENDER=noreply-hrms@wecambodia.com
APP_HRMS_FOLDER=INBOX
# Every 30 minutes. "-" switches polling off without clearing the settings.
APP_HRMS_POLL_CRON=0 */30 * * * *

# --- Per-account mail credentials (ADR-063, ADR-075) -----------------------
# Blank: the feature is OFF and that is a supported state -- no account can
# store a credential, no personal inbox is polled, and attendance mail is sent
# by MAIL_* above. Nothing crashes.
#
# Set it and read this first, because this variable does not behave like the
# others here:
#
#   * Base64 of exactly 32 random bytes:  openssl rand -base64 32
#     44 characters ending in "=". Any other length and the backend REFUSES
#     TO START, which is deliberate -- a short key is worse than no key.
#   * It is the ONLY key to every stored Gmail App Password. Change it or lose
#     it and every credential becomes permanently unreadable; each person must
#     enter theirs again. There is no recovery.
#   * It must be identical everywhere the backend runs. Two replicas with
#     different keys silently fall back to the shared sender rather than
#     erroring -- the feature degrades quietly, so it is on you to get right.
#   * Never reuse the development value. A key that has been in a terminal, a
#     chat or a .env.local protects nothing.
#
# SECRET.
APP_SECURITY_ENCRYPTION_KEY=

# --- Push notifications (ADR-025) ------------------------------------------
# Blank: the backend logs "push not configured" and starts. The bell and the
# live stream still work — neither needs Firebase.

# The service-account JSON on ONE line. Keep the \n inside private_key as the
# two characters they are; real newlines make it invalid. SECRET.
FIREBASE_CREDENTIALS=

# The browser half. Not secrets.
# COMPILED INTO THE BUNDLE — changing these needs:
#   docker compose build frontend && docker compose up -d frontend
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Cloud Messaging -> Web Push certificates. ~87 chars, starts with B.
# Not measurementId, which is Analytics and unused here.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# --- Object storage (ADR-026) ----------------------------------------------
# Needed for profile photos and content images; nothing else is affected.
# MinIO here:  invent the two keys, S3_ENDPOINT=http://minio:9000,
#              then  docker compose --profile storage up -d
# Real S3:     S3_ENDPOINT=https://s3.<region>.amazonaws.com
# The last two are secrets.
S3_ENDPOINT=s3://coc-docs-media-040105284397-ap-southeast-2-an
S3_REGION=us-east-1
S3_BUCKET=coc-docs
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=


# === TUNING ================================================================
# Sane defaults. Change when the instance says so.

DB_SCHEMA=public

# Where Postgres listens.
#   127.0.0.1  loopback only — reach it with an SSH tunnel (README). Safe.
#   0.0.0.0    reachable directly, so a tool needs only host/port/db/user/pass.
#              Requires a security group rule for 5432 from YOUR IP, never
#              0.0.0.0/0.
DB_BIND_ADDRESS=127.0.0.1
DB_POOL_MAX=10
KEYCLOAK_DB_NAME=keycloak

# Must match keycloak/docs_platform-realm.json.
KEYCLOAK_REALM=docs_platform

# Must match that file's "keycloakVersion", and what developers run locally.
# A realm exported from a newer Keycloak will not import into an older one.
KEYCLOAK_VERSION=26.7.3
KEYCLOAK_CLIENT_ID=cocdocs-frontend

# Session lifetime, ISO-8601 (AMB-006).
SESSION_TTL=P1D

# The JVM sizes its heap from BACKEND_MEMORY. Needs ~2 GB total with Postgres
# and Keycloak — t3.micro will not fit (README: Before you start).
BACKEND_MEMORY=768m
FRONTEND_MEMORY=384m

# 1 while getting DNS right: staging has no rate limit, production locks the
# domain for a week after five failures. Set back to 0 once one issues.
CERTBOT_STAGING=0
