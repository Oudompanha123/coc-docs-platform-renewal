# Coc Docs Platform — every value the deployment reads.
#
#   cp .env.example .env
#   nano .env
#   chmod 600 .env
#   docker compose up -d --build
#
# This file is the only place anything is configured. Nothing in
# docker-compose.yml, the Caddyfile or either Dockerfile needs editing to
# deploy — if you find yourself changing one of those to set a value, that is
# a bug in this file and worth saying so.
#
# .env holds real secrets and is gitignored. Keep it 0600, and keep it off
# anybody's laptop: `docker compose` reads it on the instance.

# ---------------------------------------------------------------------------
# REQUIRED — the deployment will not start without these
# ---------------------------------------------------------------------------

# The public name. A DNS A record for it must already point at this instance,
# and port 80 must be reachable, or Caddy cannot complete the Let's Encrypt
# challenge and no certificate is issued.
#
# Not an IP address and not an ec2-...amazonaws.com name: Let's Encrypt will
# not issue for either.
PUBLIC_DOMAIN=docs.example.com

# Certificate expiry warnings go here.
ACME_EMAIL=ops@example.com

# --- Database --------------------------------------------------------------
# Never exposed outside the compose network, but the password is still a real
# secret: anything that reaches the instance reaches Postgres.
DB_NAME=cocdocs
DB_USER=cocdocs
DB_PASSWORD=

# One schema in production, unlike development where each person has their own
# (CONTRIBUTING). A dedicated database has nobody to share with.
DB_SCHEMA=public
DB_POOL_MAX=10

# Keycloak's own database, created on first start by postgres-init/.
KEYCLOAK_DB_NAME=keycloak

# --- Keycloak --------------------------------------------------------------
# The first administrator. Used to create the account and then only for
# console access — change the password after the first sign-in, and treat this
# as the break-glass credential it is.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=

# Must match keycloak/docs_platform-realm.json, which is imported on first
# start. Changing either means changing the realm file too.
KEYCLOAK_REALM=docs_platform
KEYCLOAK_CLIENT_ID=cocdocs-frontend

# --- Google sign-in (ADR-013) ----------------------------------------------
# From Google Cloud Console -> APIs & Services -> Credentials.
#
# The OAuth client's Authorised redirect URI must include:
#   https://<PUBLIC_DOMAIN>/auth/realms/<KEYCLOAK_REALM>/broker/google/endpoint
# Google rejects the sign-in with redirect_uri_mismatch otherwise, and the
# message names the URI it expected, which is the one to paste back.
GOOGLE_CLIENT_ID=
# THIS IS A SECRET. Substituted into the realm at import — Keycloak does not
# resolve the placeholder itself (verified 2026-09-15).
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# OPTIONAL — each one absent degrades to a documented state, never a crash
# ---------------------------------------------------------------------------

# --- Outbound email (ADR-017) ----------------------------------------------
# spring-boot-starter-mail only autoconfigures a sender when MAIL_HOST is set.
# Blank: password-reset links are logged at WARN instead of emailed, and
# registration OTPs cannot be delivered at all — so this is optional to start
# and required for password registration to be usable.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Push notifications (ADR-025) ------------------------------------------
# The Firebase service-account JSON, on ONE line, no surrounding quotes. Keep
# the \n sequences inside private_key exactly as the downloaded file has them:
# they are JSON escapes, and turning them into real newlines makes the JSON
# invalid and the backend refuse to start.
#
# THIS IS A SECRET — it can send a notification to every registered device.
#
# Blank: the backend starts with push disabled and logs "push not configured".
# The bell and the live stream (ADR-028) are unaffected, because neither needs
# Firebase — which is the whole point of them being separate.
FIREBASE_CREDENTIALS=

# The browser half of the same Firebase project. NOT secrets: a web config is
# designed to ship inside a public bundle.
#
# COMPILED INTO THE BUNDLE. Changing any of these needs a rebuild:
#   docker compose build frontend && docker compose up -d frontend
# Restarting alone changes nothing, silently.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Cloud Messaging -> Web Push certificates. ~87 characters, starts with "B".
# Not measurementId, which is Google Analytics and unused here.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# --- Object storage (ADR-026, CONST-TECH-08) -------------------------------
# Profile photos and content-image uploads. Both take storage through an
# ObjectProvider and are simply unavailable when it is absent — everything
# else works.
#
# Two ways to fill this in:
#
#   1. MinIO, in this compose file. Invent the two keys below and start it:
#        docker compose --profile storage up -d
#      then set S3_ENDPOINT=http://minio:9000
#
#   2. Real AWS S3. Create the bucket and an IAM user with access to it, then
#      set S3_ENDPOINT=https://s3.<region>.amazonaws.com and its keys.
#
# The application only ever uses the S3 API and path-style addressing, so
# moving between the two is this file and nothing else.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=coc-docs
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# TUNING — sane defaults; change when the instance says so
# ---------------------------------------------------------------------------

# Session lifetime, ISO-8601. One day (AMB-006, ADR-011).
SESSION_TTL=P1D

# Container memory limits. The JVM sizes its heap from BACKEND_MEMORY, so that
# is the only number to change for the backend.
#
# These total roughly 1.1 GB before Postgres, Keycloak and Caddy, which
# together want another 1 GB or so. On a 2 GB instance (t3.small) it fits with
# little room; below that it does not fit at all, and the first thing the
# kernel kills is usually the JVM. See infra/README.md.
BACKEND_MEMORY=768m
FRONTEND_MEMORY=384m

# Issue against Let's Encrypt's STAGING environment — certificates browsers do
# not trust, but no meaningful rate limit. Worth 1 while you are getting DNS
# and the security group right: five failed attempts against production locks
# the domain out for a week. Set back to 0 once a staging certificate issues.
CERTBOT_STAGING=0
