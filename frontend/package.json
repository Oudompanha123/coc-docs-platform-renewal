{
  "name": "coc-docs-platform-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Presentation layer for Coc Docs Platform. Renders pages and hosts the admin editor; holds no database credentials and enforces no authorisation (ADR-012).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@blocknote/core": "0.54.0",
    "@blocknote/mantine": "0.54.0",
    "@blocknote/react": "0.54.0",
    "@mantine/core": "9.6.0",
    "@mantine/hooks": "9.6.0",
    "next": "15.5.25",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "22.10.2",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.25",
    "tailwindcss": "^4",
    "typescript": "5.7.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=20.11"
  },
  "overrides": {
    "postcss": "8.5.28"
  }
}
