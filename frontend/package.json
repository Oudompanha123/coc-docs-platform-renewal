    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tiptap/extension-placeholder": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "lucide-react": "^1.47.0",
    "next": "15.5.25",
