# Copy to .env.local and fill in. .env.local is gitignored.
# NEXT_PUBLIC_* reaches the browser — never put a secret here.

NEXT_PUBLIC_BACKEND_URL=http://localhost:8080

NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8180
NEXT_PUBLIC_KEYCLOAK_REALM=docs_platform
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=cocdocs-frontend

# Push notifications (ADR-025). All public by design — a Firebase web config
# identifies the project to Google and is meant to ship in a client bundle.
# Leave blank and the Settings toggle reports "not available", which is the
# supported state, not a failure.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Web Push certificate key pair, from Firebase console → Cloud Messaging.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
