# Copy to .env.local and fill in real values — .env.local is gitignored.

# Google OAuth 2.0 Client ID. Public by design (Google documents the Client ID,
# unlike the Client Secret, as safe to ship to the browser) — but it MUST
# exactly match the backend's GOOGLE_CLIENT_ID, since the ID token this issues
# is verified there against that same audience. // req: FR-AUTH-001
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8180
NEXT_PUBLIC_KEYCLOAK_REALM=docs_platform
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=cocdocs-frontend

# Where the Spring Boot backend is reachable from the browser.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080
